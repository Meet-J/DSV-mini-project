// =====================================================================================================
// DAX measures for the churn dashboard. Generated by `python -m src.powerbi_docs` from src/powerbi_model.py.
//
// How to add them: Modeling > New measure, paste one definition at a time (or paste several into Tabular Editor).
// Recommended: create an empty table called _Measures (Home > Enter data, one blank column, then hide the column)
// and create every measure there, so they sit together in one folder. Set the Display folder and Format shown
// above each definition. Measures reference tables by name, so they work wherever they are stored.
// =====================================================================================================


// ------------------------------------ 1 Customers ------------------------------------

// Number of customers in the current filter context. COUNTROWS is correct and faster than DISTINCTCOUNT because CustomerID is unique.
// Display folder: 1 Customers | Format: #,0
Total Customers =
    COUNTROWS(FactCustomer)

// Customers who have already left (Churn = Yes).
// Display folder: 1 Customers | Format: #,0
Churned Customers =
    CALCULATE([Total Customers], FactCustomer[ChurnFlag] = 1)

// Customers still with the company. All risk and revenue-at-risk measures build on this, because churned customers cannot be retained.
// Display folder: 1 Customers | Format: #,0
Active Customers =
    CALCULATE([Total Customers], FactCustomer[ChurnFlag] = 0)

// Share of customers who churned. DIVIDE returns blank, not 0%, for an empty selection, so an empty slice does not show a misleading 0%.
// Display folder: 1 Customers | Format: 0.0%
Churn Rate =
    DIVIDE([Churned Customers], [Total Customers])

// Churn rate of the whole customer base, ignoring every slicer. Used as the reference line on driver charts.
// Display folder: 1 Customers | Format: 0.0%
Overall Churn Rate =
    CALCULATE([Churn Rate], REMOVEFILTERS())

// Average current monthly charge (currency is not stated in the dataset).
// Display folder: 1 Customers | Format: #,0.00
Average Monthly Charges =
    AVERAGE(FactCustomer[MonthlyCharges])

// Average months with the company.
// Display folder: 1 Customers | Format: 0.0
Average Tenure (Months) =
    AVERAGE(FactCustomer[tenure])


// ------------------------------------ 2 Risk (active customers) ------------------------------------

// Active customers whose predicted churn probability is above 0.70.
// Display folder: 2 Risk (active customers) | Format: #,0
High Risk Customers =
    CALCULATE([Active Customers], DimRiskCategory[RiskCategory] = "High")

// Active customers with probability from 0.30 to 0.70.
// Display folder: 2 Risk (active customers) | Format: #,0
Medium Risk Customers =
    CALCULATE([Active Customers], DimRiskCategory[RiskCategory] = "Medium")

// Active customers with probability below 0.30.
// Display folder: 2 Risk (active customers) | Format: #,0
Low Risk Customers =
    CALCULATE([Active Customers], DimRiskCategory[RiskCategory] = "Low")

// Active customers at Medium or High risk: the broad pool a retention programme would consider.
// Display folder: 2 Risk (active customers) | Format: #,0
At-Risk Customers =
    CALCULATE([Active Customers], DimRiskCategory[RiskCategory] IN {"Medium", "High"})

// High-risk customers as a share of active customers.
// Display folder: 2 Risk (active customers) | Format: 0.0%
High Risk % of Active =
    DIVIDE([High Risk Customers], [Active Customers])

// Mean out-of-fold churn probability of active customers. A propensity (share of similar customers who left), not a time-bound forecast.
// Display folder: 2 Risk (active customers) | Format: 0.0%
Average Churn Probability (Active) =
    CALCULATE(AVERAGE(FactCustomer[ChurnProbability]), FactCustomer[ChurnFlag] = 0)

// Mean predicted probability over ALL customers; compare with Churn Rate by risk tier to see whether the tiers are honest.
// Display folder: 2 Risk (active customers) | Format: 0.0%
Average Predicted Probability =
    AVERAGE(FactCustomer[ChurnProbability])


// ------------------------------------ 3 Revenue ------------------------------------

// Sum of monthly charges. Revenue here means monthly charges only: no margin or lifetime value in the data.
// Display folder: 3 Revenue | Format: #,0
Total Monthly Charges =
    SUM(FactCustomer[MonthlyCharges])

// Monthly charges of active customers.
// Display folder: 3 Revenue | Format: #,0
Active Monthly Charges =
    CALCULATE([Total Monthly Charges], FactCustomer[ChurnFlag] = 0)

// Monthly charges of customers who already churned.
// Display folder: 3 Revenue | Format: #,0
Churned Monthly Charges =
    CALCULATE([Total Monthly Charges], FactCustomer[ChurnFlag] = 1)

// Share of monthly charges belonging to churned customers; larger than the churn rate because churners paid more.
// Display folder: 3 Revenue | Format: 0.0%
Churned Revenue Share =
    DIVIDE([Churned Monthly Charges], [Total Monthly Charges])

// Monthly charges of ACTIVE High-risk customers: the brief's 'Revenue at Risk'. Small, because the High tier is mostly customers who already left.
// Display folder: 3 Revenue | Format: #,0
Revenue at Risk (High) =
    CALCULATE([Active Monthly Charges], DimRiskCategory[RiskCategory] = "High")

// Monthly charges of active customers at Medium or High risk.
// Display folder: 3 Revenue | Format: #,0
Revenue at Risk (Medium + High) =
    CALCULATE([Active Monthly Charges], DimRiskCategory[RiskCategory] IN {"Medium", "High"})

// Probability x monthly charge, summed over active customers (the column is 0 for churned customers). Propensity-weighted exposure, not a forecast.
// Display folder: 3 Revenue | Format: #,0
Expected Revenue at Risk =
    SUM(FactCustomer[ExpectedMonthlyRevenueAtRisk])

// Expected revenue at risk as a share of active monthly charges.
// Display folder: 3 Revenue | Format: 0.0%
Expected Revenue at Risk % =
    DIVIDE([Expected Revenue at Risk], [Active Monthly Charges])


// ------------------------------------ 4 Value ------------------------------------

// Active customers whose monthly charge is in the top quartile of all customers.
// Display folder: 4 Value | Format: #,0
High-Value Customers =
    CALCULATE([Active Customers], FactCustomer[ValueSegment] = "High value")

// High-value active customers at Medium or High risk.
// Display folder: 4 Value | Format: #,0
High-Value At-Risk Customers =
    CALCULATE([Active Customers], FactCustomer[ValueSegment] = "High value", DimRiskCategory[RiskCategory] IN {"Medium", "High"})


// ------------------------------------ 5 Formatting ------------------------------------

// Bar colour: red when a group's churn rate is more than 2 points above the overall rate, grey-blue otherwise (the same rule as the Python charts).
// Display folder: 5 Formatting
Churn Bar Color =
    IF([Churn Rate] > [Overall Churn Rate] + 0.02, "#C0504D", "#B8C2CF")

// Hex colour of the risk tier in the current row or bar, for 'format by field value'.
// Display folder: 5 Formatting
Risk Color =
    MAX(DimRiskCategory[ColorHex])


// ------------------------------------ 6 Model checks ------------------------------------

// Customers whose value in some dimension is missing from that dimension table. Must be 0; anything else means a level is missing from a dimension.
// Display folder: 6 Model checks | Format: #,0
Unmapped Customers =
    COUNTROWS(FILTER(FactCustomer, ISBLANK(RELATED(DimContract[ContractOrder]))
        || ISBLANK(RELATED(DimInternetService[InternetServiceOrder]))
        || ISBLANK(RELATED(DimPaymentMethod[PaymentMethodOrder]))
        || ISBLANK(RELATED(DimTenureGroup[TenureGroupOrder]))
        || ISBLANK(RELATED(DimChargeBand[ChargeBandOrder]))
        || ISBLANK(RELATED(DimRiskCategory[RiskOrder]))
        || ISBLANK(RELATED(DimCustomerStatus[StatusOrder]))
        || ISBLANK(RELATED(DimRetentionSegment[SegmentOrder]))))
